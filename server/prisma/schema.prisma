
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Report {
  id          Int      @id @default(autoincrement())
  category    String
  description String
  location    String
  latitude    Float?
  longitude   Float?
  evidenceUrl String?
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Authority {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  department String
  createdAt  DateTime @default(now())
}
